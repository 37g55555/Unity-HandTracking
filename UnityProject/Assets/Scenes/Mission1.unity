  narrationChain:
  - audioClip: {fileID: 8300000, guid: 20e2d0a40b19ac6478b9eb94f465d3b1, type: 3}
    subtitle: "\uC61B \uCD94\uC5B5\uC744 \uB5A0\uC62C\uB9AC\uBA70, \uADF8\uB9BC\uC790\uB294
      \uC544\uC774\uB97C \uB9CC\uB098\uACE0 \uC2F6\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: db97046d05afd8c40bce61ddf4e3f47c, type: 3}
    subtitle: "\uAE38\uC744 \uB098\uC130\uC9C0\uB9CC, \uC5BC\uB9C8 \uC548 \uAC00
      \uC8FC\uBCC0\uC5D0 \uC628\uD1B5 \uC5B4\uB460\uC774 \uC84C\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 577a9b7c0eca78142970e1dde194cc78, type: 3}
    subtitle: "\" \uB098\uB294 \uC5B4\uB460\uC5D0\uC11C\uB294 \uC0B4 \uC218 \uC5C6\uB294\uB370...
      \uC5B4\uB5A1\uD558\uC9C0? \""
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 3534f532fc774e269d5c24441fe187aa, type: 3}
    subtitle: "\uADF8 \uB54C, \uD55C \uCABD \uBCBD\uC5D0 \uBCC4\uBE5B\uC774 \uB4DC\uB9AC\uC6E0\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 6c93f9519cf8ad1479987bcee03783a1, type: 3}
    subtitle: "\uC544\uCE68\uC774 \uBC1D\uACE0, \uADF8\uB9BC\uC790\uB294 \uB2E4\uC2DC
      \uD798\uCC28\uAC8C \uCD9C\uBC1C\uD588\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 8cff13e65cae18745ab20336b5571f9c, type: 3}
    subtitle: "\" \uC88B\uC544, \uB2E4\uC2DC \uAC00 \uBCFC\uAE4C? \""
    gapAfterSeconds: 1
