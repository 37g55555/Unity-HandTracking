--- !u!114 &400005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 400000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 990e7c503d0044fab12219126bebef64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  audioSource: {fileID: 400003}
  subtitleController: {fileID: 400004}
  narrationChain:
  - audioClip: {fileID: 8300000, guid: 6d2ab0d2cab646241aa5cff2b2064602, type: 3}
    subtitle: "\uC544\uCE68\uC774 \uBC1D\uC744 \uB54C\uAE4C\uC9C0, \uADF8\uB9BC\uC790\uB294
      \uBB34\uC0AC\uD788 \uBCC4\uBE5B\uC5D0 \uBAB8\uC744 \uC228\uACBC\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 8cff13e65cae18745ab20336b5571f9c, type: 3}
    subtitle: "\" \uC88B\uC544, \uB2E4\uC2DC \uAC00 \uBCFC\uAE4C? \""
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 2e7cccaad51fa61428255ac2a61629fa, type: 3}
    subtitle: "\uAE38\uC744 \uB098\uC11C\uB824\uACE0 \uBCF4\uB2C8, \uADF8\uB9BC\uC790\uB294
      \uC790\uC2E0\uC774 \uB098\uC544\uAC00\uB294 \uC18D\uB3C4\uAC00 \uB108\uBB34
      \uB290\uB9AC\uB2E4\uB294 \uAC78 \uAE68\uB2EC\uC558\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 7c9f690dcae216144bb916a966bca28a, type: 3}
    subtitle: " \" \uC774\uB7F0 \uC885\uC885 \uAC78\uC74C\uC73C\uB860, \uB610 \uAE08\uBC29
      \uBC24\uC774 \uC62C\uAEBC\uC57C! \u201D"
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 1c4e88026b81364499b4cbb841bdaadb, type: 3}
    subtitle: "\uB354 \uD070 \uAC78\uC74C\uC73C\uB85C \uC774\uB3D9\uD558\uAE30 \uC704\uD574,
      \uADF8\uB9BC\uC790\uB294 \uACB0\uC2EC\uC744 \uD569\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: a109c4f04e0199240ab37377c6c6a959, type: 3}
    subtitle: "\" \uC544\uBB34\uB798\uB3C4 \uC9C0\uAE08\uBCF4\uB2E4 \uD6E8\uC52C
      \uCEE4\uC838\uC57C\uACA0\uC5B4! \u201D"
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: 1a10255517058874bbdedc3534b2e6ae, type: 3}
    subtitle: "\uBAB8\uC9D1\uC744 \uD0A4\uC6B4 \uADF8\uB9BC\uC790\uB294 \uB9CC\uC871\uC2A4\uB7EC\uC6B4
      \uBAA9\uC18C\uB9AC\uB85C \uB9D0\uD588\uC2B5\uB2C8\uB2E4."
    gapAfterSeconds: 1
  - audioClip: {fileID: 8300000, guid: f990dc0130abad5499b10e00d9e1a79f, type: 3}
    subtitle: "\" \uC774 \uC815\uB3C4\uBA74 \uBB38\uC81C\uC5C6\uC9C0! \""
    gapAfterSeconds: 1
